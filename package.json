{
  "name": "chops",
  "description": "CHOps - ClickHouse® Administration Dashboard",
  "author": "Quantrail™ Data Private Limited",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
    "dev:backend": "bun run gen:version && bun --watch src/backend/server.js",
    "dev:frontend": "vite",
    "build": "bun run gen:version && bun run gen:icons && vite build",
    "check:bundle": "bun scripts/check-bundle-size.mjs",
    "embed": "bun scripts/embed-static.js",
    "gen:search-headers": "node scripts/build-search-headers.mjs",
    "gen:version": "node scripts/generate-version.mjs",
    "gen:icons": "node scripts/build-icon-sprite.mjs",
    "build:binary": "bun run build && bun run embed && bun build src/backend/server.js --compile --outfile chops",
    "build:binary:linux": "bun run build && bun run embed && bun build src/backend/server.js --compile --target=bun-linux-x64 --outfile chops-linux-x64",
    "build:binary:mac": "bun run build && bun run embed && bun build src/backend/server.js --compile --target=bun-darwin-arm64 --outfile chops-darwin-arm64",
    "build:binary:windows": "bun run build && bun run embed && bun build src/backend/server.js --compile --target=bun-windows-x64 --outfile chops-windows-x64.exe",
    "build:standalone:mac": "bun run build && bun run embed && bun build src/backend/server.js --compile --env=inline --target=bun-darwin-arm64 --outfile chops-darwin-arm64",
    "build:standalone:linux": "bun run build && bun run embed && bun build src/backend/server.js --compile --env=inline --target=bun-linux-x64 --outfile chops-linux-x64",
    "build:standalone:windows": "bun run build && bun run embed && bun build src/backend/server.js --compile --env=inline --target=bun-windows-x64 --outfile chops-windows-x64.exe",
    "test": "bun run test:backend && vitest run tests/frontend",
    "test:backend": "bun scripts/test-each-file.mjs tests/backend && bun test tests/isolated && bun test tests/no-mocks && bun test tests/db && bun test tests/net && bun test tests/security",
    "test:coverage": "bun run test:backend:coverage && bun run test:frontend:coverage",
    "test:backend:coverage": "bun scripts/test-backend-coverage.mjs",
    "test:frontend:coverage": "vitest run tests/frontend --coverage",
    "test:visual": "bun tests/visual/check.mjs && bun tests/visual/compare.mjs",
    "visual:record": "bun tests/visual/record.mjs",
    "visual:check": "bun tests/visual/check.mjs",
    "visual:compare": "bun tests/visual/compare.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "check:sensitive-logging": "node scripts/check-sensitive-logging.mjs",
    "check:readonly": "node scripts/check-readonly-settings.mjs",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun src/backend/db/migrate.js",
    "db:migrate:dry-run": "bun src/backend/db/migrate.js --migrate-dry-run",
    "db:backup": "bun src/backend/db/backup.js",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@base-ui/react": "1.9.0",
    "@clickhouse/client": "^1.21.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/b612": "^5.2.7",
    "@fontsource/red-hat-mono": "^5.2.8",
    "@google/genai": "^2.11.0",
    "@lezer/highlight": "^1.2.5",
    "@mistralai/mistralai": "^2.4.1",
    "@opentelemetry/api": "^1.9.1",
    "@react-oauth/google": "^0.13.5",
    "@tabler/icons-react": "3.50.0",
    "@tabler/icons-webfont": "3.50.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.1",
    "axios": "^1.18.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "drizzle-orm": "^0.45.2",
    "echarts": "6.1.0",
    "embla-carousel-react": "8.6.0",
    "express": "5.1.0",
    "farmhash": "^5.0.1",
    "fflate": "^0.8.3",
    "fuse.js": "^7.5.0",
    "html-to-image": "1.11.11",
    "js-yaml": "4.3.1",
    "jsonwebtoken": "9.0.2",
    "motion": "14.9.1",
    "nodemailer": "9.0.5",
    "openai": "^6.47.0",
    "pdfkit": "^0.19.1",
    "react": "19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.3.1",
    "react-otp-input": "^3.1.1",
    "react-resizable-panels": "4.17.0",
    "react-router-dom": "7.18.5",
    "sonner": "2.0.8",
    "sql-formatter": "15.9.0",
    "swiper": "^12.2.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.4",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-istanbul": "5.1.0",
    "axe-core": "4.13.0",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "30.1.3",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "postcss": "^8.5.23",
    "nanoid": "^3.3.16",
    "tar": "^7.5.21",
    "undici": "^6.28.0",
    "svgo": "^3.3.4",
    "ip-address": "^10.3.1",
    "protobufjs": "^7.6.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
