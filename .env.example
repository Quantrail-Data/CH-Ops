# CHOps environment configuration (example)
#
# Copy this file to .env and fill in real values. This file lists the common
# variables. docs/getting-started/configuration.md lists all of them. Only the
# items marked REQUIRED must be set for the server to start. Everything else
# has a default.

# Super admin seeding (REQUIRED)
# At least the first super admin (SUPER_ADMIN_1, SUPER_ADMIN_1_PASSWORD and
# SUPER_ADMIN_1_EMAIL) must be set. You can define up to three numbered super admins. These accounts are
# created on first startup and are used for initial setup and emergency login.
SUPER_ADMIN_1=admin
SUPER_ADMIN_1_PASSWORD=change_me_to_a_strong_password
SUPER_ADMIN_1_EMAIL=change_with_your_mailID
# SUPER_ADMIN_2=admin2
# SUPER_ADMIN_2_PASSWORD=another_strong_password
# SUPER_ADMIN_2_EMAIL=superadmin@mailid
# SUPER_ADMIN_3=admin3
# SUPER_ADMIN_3_PASSWORD=yet_another_strong_password
# SUPER_ADMIN_3_EMAIL=superadmin@mailid

# Legacy single-admin format (still accepted if the numbered vars are absent):
# SUPER_ADMIN=admin
# SUPER_ADMIN_PASSWORD=change_me
# SUPER_ADMIN_EMAIL=change_with_your_mailID

# Encryption secret (REQUIRED)
# The key material for every stored password: ClickHouse, email, and AI keys.
#
# Make one with: openssl rand -hex 32
#
# NEVER CHANGE THIS after the first start. It is not a session secret, and it
# cannot be rotated. A new value makes every stored password unreadable, and
# they cannot be recovered.
#
# Upgrading? This was called SESSION_SECRET. Rename it and keep the same value.

ENCRYPTION_SECRET=replace_with_a_long_random_secret_32_chars_min

# Server
# Port the backend listens on (default 3000) and the runtime environment.
PORT=3000
NODE_ENV=development

# Set to true to disable the .env super-admin login fallback once real users
# exist in the app database. Leave unset (or false) during initial setup.
DISABLE_ENV_LOGIN=true


# Build / version metadata (optional)
# Populated by the build pipeline; usually left blank in local development.
CLICKHOUSEVERSION=
MAJOR=
MINOR=
PATCH=
DISPLAY=
VERSION=
CODENAME=

# Frontend Env key-values
# TLS REJECT_UNAUTHORIZED = '0';

# Chat history key for localstorage 
VITE_QURIOZ_KEY=quriozchatstorage

#SELECTAIIDS for localstorage
VITE_SELECTEDAID_DBS=aiselectedid

# Mail to login page navigating URl
FRONTEND_LINK=http://localhost:5173

# Ceiling on how much a single query may return to the application, in bytes.
# Default 134217728 (128 MB). Raise it on a larger host.
MAX_RESULT_BYTES=134217728

# Optional. The values below are the defaults.
# DB_PATH=./data/chops.db
# EXPORT_DIR=./data/exports
# LOG_LEVEL=info
# Set TRUST_PROXY to the number of reverse proxies in front of CHOps.
# TRUST_PROXY=1
# A PEM file with more certificate authorities for ClickHouse connections.
# NODE_EXTRA_CA_CERTS=/path/to/ca.pem
